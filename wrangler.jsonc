{
  // Cloudflare Workers static assets: serves docs/ at https://kcos.21no.de.
  //   npx wrangler dev      preview locally
  //   npx wrangler deploy   publish (or let Cloudflare build on push to main)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kcontaineros",
  "compatibility_date": "2026-06-01",
  "routes": [
    { "pattern": "kcos.21no.de", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./docs",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
